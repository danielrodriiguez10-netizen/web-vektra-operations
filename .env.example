# Copia este archivo como .env.local (y en Vercel, en Settings > Environment Variables).
# Envío de solicitudes del Mapa gratuito con Resend (resend.com).
# Sin estas variables, en local las solicitudes se muestran en la consola del servidor.
RESEND_API_KEY=
# Buzón donde quieres recibir las solicitudes
LEADS_TO_EMAIL=
# Remitente de un dominio verificado en Resend, por ejemplo: Vektra Web <web@vektraoperations.com>
LEADS_FROM_EMAIL=
