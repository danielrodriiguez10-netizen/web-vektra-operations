# Copia este archivo como .env.local (y en Hostinger, en las variables de entorno de la app).
# Envío de solicitudes del Mapa gratuito con el correo de Hostinger.
# Sin SMTP_PASSWORD, en local las solicitudes se muestran en la consola del servidor.

# Contraseña del buzón vektraoperations@vektraoperations.com (la única obligatoria)
SMTP_PASSWORD=

# Opcionales: valores por defecto entre paréntesis
# SMTP_USER=      (vektraoperations@vektraoperations.com)
# SMTP_HOST=      (smtp.hostinger.com)
# SMTP_PORT=      (465)
# LEADS_TO_EMAIL= (vektraoperations@vektraoperations.com)
